@model OwnerDashboardViewModel
@{
    ViewData["Title"] = "Chủ sân Dashboard - CourtBook";
    var distribution = Model.SlotDistribution;
}

<div class="container" style="padding-top: 1.5rem; padding-bottom: 4rem;">
    <div class="owner-layout">
        <aside class="owner-sidebar">
            <div class="card" style="padding: 0.5rem; border-color: var(--cb-border); background-color: white; position: sticky; top: 5rem;">
                <nav class="sidebar-nav">
                    <a asp-controller="Owner" asp-action="Dashboard" class="sidebar-link active">
                        <i data-lucide="trending-up" style="width:16px;height:16px"></i> Tổng quan
                    </a>
                    <a asp-controller="Owner" asp-action="Venues" class="sidebar-link">
                        <i data-lucide="building-2" style="width:16px;height:16px"></i> Cụm sân của tôi
                    </a>
                    <a asp-controller="Owner" asp-action="Venues" class="sidebar-link">
                        <i data-lucide="layers" style="width:16px;height:16px"></i> Sân con
                    </a>
                    <a asp-controller="Owner" asp-action="Dashboard" asp-fragment="owner-bookings" class="sidebar-link">
                        <i data-lucide="calendar-days" style="width:16px;height:16px"></i> Booking
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="sidebar-link">
                        <i data-lucide="wallet" style="width:16px;height:16px"></i> Hồ sơ chủ sân
                    </a>
                </nav>
            </div>
        </aside>

        <section style="min-width: 0;">
            <div class="flex-between flex-wrap gap-3 mb-5">
                <div>
                    <h1 style="font-size: 1.75rem;">Chào, @Model.OwnerName</h1>
                    <p class="text-secondary text-sm" style="margin-top: 0.25rem;">
                        @(string.IsNullOrWhiteSpace(Model.OverviewText)
                            ? "Theo dõi booking, doanh thu và tình trạng sân theo dữ liệu thực trên hệ thống."
                            : Model.OverviewText)
                    </p>
                </div>
                <a asp-controller="Owner" asp-action="Venues" class="btn btn-primary">
                    <i data-lucide="settings" style="width:16px;height:16px"></i> Quản lý cụm sân
                </a>
            </div>

            <div class="owner-stats-grid">
                <div class="card stat-card" style="border-color: var(--cb-border); background-color: white;">
                    <div class="flex-between">
                        <div>
                            <div class="stat-label">Booking hôm nay</div>
                            <div class="stat-value">@Model.TodayBookings</div>
                        </div>
                        <div class="stat-icon" style="background-color: var(--cb-primary-light); color: var(--cb-primary)">
                            <i data-lucide="calendar-days" style="width:18px;height:18px"></i>
                        </div>
                    </div>
                    <div class="stat-delta" style="color: var(--cb-text-muted);">@Model.TotalBookings booking thuộc toàn bộ cụm sân của bạn</div>
                </div>

                <div class="card stat-card" style="border-color: var(--cb-border); background-color: white;">
                    <div class="flex-between">
                        <div>
                            <div class="stat-label">Chờ xác nhận</div>
                            <div class="stat-value" style="color: #d97706">@Model.PendingCount</div>
                        </div>
                        <div class="stat-icon" style="background-color: #fffbeb; color: #d97706">
                            <i data-lucide="clock" style="width:18px;height:18px"></i>
                        </div>
                    </div>
                    <div class="stat-delta" style="color: #d97706;">@((Model.PendingCount > 0) ? "Cần xử lý ngay trên bảng booking." : "Không còn booking nào cần duyệt.")</div>
                </div>

                <div class="card stat-card" style="border-color: var(--cb-border); background-color: white;">
                    <div class="flex-between">
                        <div>
                            <div class="stat-label">Doanh thu đã chốt</div>
                            <div class="stat-value" style="color: var(--cb-primary)">@MockData.FormatVND(Model.Revenue)</div>
                        </div>
                        <div class="stat-icon" style="background-color: var(--cb-primary-light); color: var(--cb-primary)">
                            <i data-lucide="wallet" style="width:18px;height:18px"></i>
                        </div>
                    </div>
                    <div class="stat-delta" style="color: var(--cb-text-muted);">Tính từ booking đã xác nhận hoặc hoàn thành</div>
                </div>

                <div class="card stat-card" style="border-color: var(--cb-border); background-color: white;">
                    <div class="flex-between">
                        <div>
                            <div class="stat-label">Sân đang hoạt động</div>
                            <div class="stat-value">@Model.ActiveCourts</div>
                        </div>
                        <div class="stat-icon" style="background-color: var(--cb-section-alt); color: var(--cb-text-secondary)">
                            <i data-lucide="layers" style="width:18px;height:18px"></i>
                        </div>
                    </div>
                    <div class="stat-delta" style="color: var(--cb-text-muted);">Tỷ lệ sân có thể nhận booking mới trên site</div>
                </div>
            </div>

            <div class="owner-charts-grid">
                <div class="card" style="padding: 1.5rem; border-color: var(--cb-border); background-color: white;">
                    <div class="flex-between" style="margin-bottom: 1.25rem;">
                        <div>
                            <h3 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Doanh thu 7 ngày qua</h3>
                            <p class="text-xs text-muted" style="margin-top: 0.25rem;">Biểu đồ chỉ tính booking đã được chủ sân chốt trạng thái.</p>
                        </div>
                        <span class="badge badge-slate">Triệu đồng</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="revenue-bar-chart"></canvas>
                    </div>
                </div>

                <div class="card" style="padding: 1.5rem; border-color: var(--cb-border); background-color: white; height: fit-content;">
                    <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.25rem;">Phân bổ slot hôm nay</h3>
                    <p class="text-xs text-muted" style="margin-bottom: 1.25rem;">Tính trên tất cả sân công khai đang hoạt động của bạn.</p>

                    @if (distribution.Total == 0)
                    {
                        <div style="padding: 1rem; border-radius: var(--cb-radius); background-color: var(--cb-section-alt); border: 1px dashed var(--cb-border); font-size: 0.875rem; color: var(--cb-text-muted);">
                            Chưa có sân công khai đang hoạt động để tính phân bổ slot hôm nay.
                        </div>
                    }
                    else
                    {
                        <div class="slot-distribution">
                            <div>
                                <div class="flex-between" style="font-size: 0.75rem; margin-bottom: 0.25rem;">
                                    <span class="text-secondary">Đã xác nhận</span>
                                    <span class="font-semibold text-slate-900">@distribution.Confirmed slots (@distribution.ConfirmedPercent%)</span>
                                </div>
                                <div class="cb-progress-bar">
                                    <div class="progress-fill progress-emerald" style="width: @distribution.ConfirmedPercent%"></div>
                                </div>
                            </div>

                            <div>
                                <div class="flex-between" style="font-size: 0.75rem; margin-bottom: 0.25rem;">
                                    <span class="text-secondary">Chờ duyệt</span>
                                    <span class="font-semibold text-slate-900">@distribution.Pending slots (@distribution.PendingPercent%)</span>
                                </div>
                                <div class="cb-progress-bar">
                                    <div class="progress-fill progress-amber" style="width: @distribution.PendingPercent%"></div>
                                </div>
                            </div>

                            <div>
                                <div class="flex-between" style="font-size: 0.75rem; margin-bottom: 0.25rem;">
                                    <span class="text-secondary">Còn trống</span>
                                    <span class="font-semibold text-slate-900">@distribution.Available slots (@distribution.AvailablePercent%)</span>
                                </div>
                                <div class="cb-progress-bar">
                                    <div class="progress-fill progress-slate" style="width: @distribution.AvailablePercent%"></div>
                                </div>
                            </div>
                        </div>
                    }

                    <div style="margin-top: 1.5rem; padding: 0.75rem; border-radius: var(--cb-radius); background-color: var(--cb-primary-light); border: 1px solid var(--cb-primary-100); font-size: 0.75rem; color: var(--cb-primary-800); line-height: 1.4;">
                        @if (Model.PendingCount > 0)
                        {
                            <text><strong>Cần xử lý:</strong> Bạn còn @Model.PendingCount booking đang chờ duyệt. Hãy phản hồi sớm để tránh mất khách.</text>
                        }
                        else
                        {
                            <text><strong>Ổn định:</strong> Không còn booking chờ xác nhận. Bạn có thể chuyển sang quản lý venue và tối ưu giá sân.</text>
                        }
                    </div>
                </div>
            </div>

            <div class="card" id="owner-bookings" style="border-color: var(--cb-border); background-color: white;">
                <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--cb-border)">
                    <h3 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Booking thuộc cụm sân của bạn</h3>
                    <p class="text-xs text-muted" style="margin-top: 0.25rem;">Owner chỉ thấy booking thuộc venue của chính mình và có thể duyệt hoặc từ chối yêu cầu đang pending.</p>
                </div>

                <div class="table-wrapper">
                    <table class="cb-table">
                        <thead>
                            <tr>
                                <th>Khách hàng</th>
                                <th>Cụm sân</th>
                                <th>Sân con</th>
                                <th>Thời gian</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th style="text-align: right;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Bookings.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" style="padding: 1.5rem; text-align: center; color: var(--cb-text-muted);">
                                        Chưa có booking nào thuộc quyền quản lý của bạn.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var booking in Model.Bookings)
                                {
                                    <tr>
                                        <td>
                                            <div class="font-semibold text-slate-900">@booking.Customer</div>
                                            <div class="text-xs text-muted">@booking.Phone</div>
                                        </td>
                                        <td class="font-medium text-slate-700">@booking.VenueName</td>
                                        <td class="font-medium text-slate-700">@booking.Court</td>
                                        <td class="text-slate-700">@booking.Time</td>
                                        <td class="font-semibold text-slate-900">@MockData.FormatVND(booking.Total)</td>
                                        <td>@await Html.PartialAsync("_StatusBadge", booking.Status)</td>
                                        <td style="text-align: right; vertical-align: middle;">
                                            @if (booking.CanReview)
                                            {
                                                <div style="display: inline-flex; gap: 0.375rem; justify-content: flex-end; flex-wrap: wrap;">
                                                    <form asp-controller="Owner" asp-action="RejectBooking" asp-route-id="@booking.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-destructive btn-sm">Từ chối</button>
                                                    </form>
                                                    <form asp-controller="Owner" asp-action="ApproveBooking" asp-route-id="@booking.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-primary btn-sm">Duyệt sân</button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-muted">Không cần xử lý thêm</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        window.revenueChartData = {
            labels: @Html.Raw(Json.Serialize(Model.RevenueData.Select(x => x.Day))),
            values: @Html.Raw(Json.Serialize(Model.RevenueData.Select(x => x.Value)))
        };
    </script>
    <script src="~/js/owner-dashboard.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["ToastMessage"] != null)
            {
                <text>
                if (window.showToast) {
                    window.showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]", 4000);
                }
                </text>
            }
        });
    </script>
}
