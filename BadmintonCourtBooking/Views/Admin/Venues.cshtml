@model AdminVenueManagementViewModel
@{
    ViewData["Title"] = "Quản lý cụm sân - Đặt Sân Cầu Lông";
    var selectedVenue = Model.Venues.FirstOrDefault(venue => venue.Id == Model.SelectedVenueId)
        ?? Model.Venues.FirstOrDefault();
}

<div class="container" style="padding-top: 1.5rem; padding-bottom: 4rem;">
    <div class="admin-venue-layout">
        <aside class="admin-venue-sidebar">
            <div class="card" style="padding: 0.5rem; border-color: var(--cb-border); background-color: white; position: sticky; top: 5rem;">
                <nav class="sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index" class="sidebar-link">
                        <i data-lucide="trending-up" style="width:16px;height:16px"></i> Tổng quan
                    </a>
                    <a asp-controller="Admin" asp-action="Venues" class="sidebar-link active">
                        <i data-lucide="building-2" style="width:16px;height:16px"></i> Cụm sân
                    </a>
                </nav>
            </div>
        </aside>

        <section style="min-width: 0;">
            <div class="flex-between flex-wrap gap-3 mb-5">
                <div>
                    <h1 style="font-size: 1.75rem;">Quản lý cụm sân</h1>
                    <p class="text-secondary text-sm" style="margin-top: 0.25rem;">Quản trị viên quản lý toàn bộ cụm sân và sân con trong hệ thống. Cụm sân mới được tạo sẽ công khai ngay.</p>
                </div>
                <a href="#new-venue-form" class="btn btn-primary">
                    <i data-lucide="plus" style="width:16px;height:16px"></i> Tạo cụm sân mới
                </a>
            </div>

            <div class="venues-manage-layout">
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @if (!Model.HasVenues)
                    {
                        <div class="card" style="padding: 1rem; border: 1px dashed var(--cb-border); background-color: white;">
                            <div class="font-semibold text-slate-900">Chưa có cụm sân nào</div>
                            <p class="text-sm text-secondary" style="margin-top: 0.375rem;">Điền biểu mẫu bên phải để tạo cụm sân đầu tiên.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var venue in Model.Venues)
                        {
                            var isSelected = selectedVenue?.Id == venue.Id;
                            <a asp-controller="Admin"
                               asp-action="Venues"
                               asp-route-selectedVenueId="@venue.Id"
                               class="card venue-list-card @(isSelected ? "selected" : string.Empty)"
                               style="padding: 1rem; border-color: var(--cb-border); background-color: white; text-decoration: none;">
                                <div class="flex-between">
                                    <div>
                                        <h3 class="font-semibold text-slate-900" style="font-size: 1rem; margin: 0;">@venue.Name</h3>
                                        <div class="text-xs text-muted flex items-center gap-1 mt-1">
                                            <i data-lucide="map-pin" style="width:12px;height:12px"></i> @venue.District
                                        </div>
                                    </div>
                                    <span class="badge badge-@venue.StatusTone">@venue.StatusLabel</span>
                                </div>
                                <div class="text-xs text-secondary" style="margin-top: 1rem;">
                                    @venue.ActiveCourtCount/@venue.TotalCourtCount sân đang hoạt động · từ @MockData.FormatVND(venue.PriceFrom)/giờ
                                </div>
                            </a>
                        }
                    }

                    <div class="card" style="padding: 1rem; border-style: dashed; border-color: var(--cb-border); background-color: var(--cb-section-alt); font-size: 0.8125rem; color: var(--cb-text-muted);">
                        <div style="display: flex; gap: 0.5rem; align-items: flex-start;">
                            <i data-lucide="shield-check" style="width:16px;height:16px; color: var(--cb-primary); margin-top: 2px;"></i>
                            <div>Trang này hiển thị toàn bộ cụm sân trong cơ sở dữ liệu. Trạng thái công khai/ẩn được điều khiển trên trang tổng quan của Quản trị viên.</div>
                        </div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                    @if (selectedVenue is not null)
                    {
                        <div class="card" style="padding: 1.5rem; border-color: var(--cb-border); background-color: white;">
                            <div class="flex-between flex-wrap gap-3" style="margin-bottom: 1.25rem;">
                                <div>
                                    <h3 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Thông tin cụm sân</h3>
                                    <p class="text-xs text-muted" style="margin-top: 0.25rem;">@selectedVenue.StatusDescription</p>
                                </div>
                                <span class="badge badge-@selectedVenue.StatusTone">@selectedVenue.StatusLabel</span>
                            </div>

                            <form asp-controller="Admin" asp-action="UpdateVenue" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@selectedVenue.Id" />
                                <input type="hidden" name="SelectedVenueId" value="@selectedVenue.Id" />

                                <div style="display: flex; flex-direction: column; gap: 1rem;">
                                    <div class="form-grid-2">
                                        <div class="form-group">
                                            <label class="form-label" for="venue-name-@selectedVenue.Id">Tên cụm sân</label>
                                            <input id="venue-name-@selectedVenue.Id" name="Name" type="text" class="form-input" value="@selectedVenue.Name" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label" for="venue-district-@selectedVenue.Id">Khu vực</label>
                                            <input id="venue-district-@selectedVenue.Id" name="District" type="text" class="form-input" value="@selectedVenue.District" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="venue-address-@selectedVenue.Id">Địa chỉ cụ thể</label>
                                        <input id="venue-address-@selectedVenue.Id" name="Address" type="text" class="form-input" value="@selectedVenue.Address" />
                                    </div>

                                    <div class="form-grid-2">
                                        <div class="form-group">
                                            <label class="form-label" for="venue-contact-name-@selectedVenue.Id">Người liên hệ</label>
                                            <input id="venue-contact-name-@selectedVenue.Id" name="ContactName" type="text" class="form-input" value="@selectedVenue.ContactName" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label" for="venue-contact-phone-@selectedVenue.Id">Số điện thoại liên hệ</label>
                                            <input id="venue-contact-phone-@selectedVenue.Id" name="ContactPhone" type="text" class="form-input" value="@selectedVenue.ContactPhone" />
                                        </div>
                                    </div>

                                    <div class="form-grid-2">
                                        <div class="form-group">
                                            <label class="form-label" for="venue-open-@selectedVenue.Id">Giờ mở cửa</label>
                                            <input id="venue-open-@selectedVenue.Id" name="OpenTime" type="text" class="form-input" value="@selectedVenue.OpenTime" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label" for="venue-close-@selectedVenue.Id">Giờ đóng cửa</label>
                                            <input id="venue-close-@selectedVenue.Id" name="CloseTime" type="text" class="form-input" value="@selectedVenue.CloseTime" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="venue-desc-@selectedVenue.Id">Mô tả cụm sân</label>
                                        <textarea id="venue-desc-@selectedVenue.Id" name="Description" class="form-textarea" rows="4">@selectedVenue.Description</textarea>
                                    </div>
                                </div>

                                <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1.25rem;">
                                    <a asp-controller="Admin" asp-action="Venues" asp-route-selectedVenueId="@selectedVenue.Id" class="btn btn-outline">Tải lại</a>
                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                </div>
                            </form>
                        </div>

                        <div class="card" style="padding: 1.5rem; border-color: var(--cb-border); background-color: white;">
                            <div class="flex-between flex-wrap gap-3" style="margin-bottom: 1.25rem;">
                                <div>
                                    <h3 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Sân con thuộc @selectedVenue.Name</h3>
                                    <p class="text-xs text-muted" style="margin-top: 0.25rem;">Bỏ chọn trạng thái hoạt động để tạm ngưng sân. Nếu sân đang có lượt đặt sân sắp tới, hệ thống sẽ chặn thao tác.</p>
                                </div>
                                <span class="badge badge-slate">@selectedVenue.TotalCourtCount sân</span>
                            </div>

                            <div style="display: flex; flex-direction: column; gap: 1rem;">
                                @if (selectedVenue.Courts.Count == 0)
                                {
                                    <div style="padding: 1rem; border: 1px dashed var(--cb-border); border-radius: var(--cb-radius); background-color: var(--cb-section-alt); color: var(--cb-text-muted);">
                                        Cụm sân này chưa có sân con nào. Dùng biểu mẫu bên dưới để tạo sân đầu tiên.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var court in selectedVenue.Courts)
                                    {
                                        <form asp-controller="Admin" asp-action="UpdateCourt" method="post" style="border: 1px solid var(--cb-border-light); border-radius: var(--cb-radius); padding: 1rem; background-color: var(--cb-section-alt); display: flex; flex-direction: column; gap: 0.875rem;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@court.Id" />
                                            <input type="hidden" name="VenueId" value="@selectedVenue.Id" />
                                            <input type="hidden" name="SelectedVenueId" value="@selectedVenue.Id" />

                                            <div class="flex-between flex-wrap gap-3">
                                                <div class="font-semibold text-slate-900">@court.Name</div>
                                                <span class="badge badge-@court.AvailabilityTone">@court.AvailabilityLabel</span>
                                            </div>

                                            <div class="form-grid-2">
                                                <div class="form-group">
                                                    <label class="form-label" for="court-name-@court.Id">Tên sân</label>
                                                    <input id="court-name-@court.Id" name="Name" type="text" class="form-input" value="@court.Name" />
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label" for="court-price-@court.Id">Giá thuê mỗi giờ</label>
                                                    <input id="court-price-@court.Id" name="PricePerHour" type="number" class="form-input" min="50000" step="5000" value="@court.PricePerHour" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label" for="court-note-@court.Id">Ghi chú</label>
                                                <input id="court-note-@court.Id" name="Note" type="text" class="form-input" value="@court.Note" placeholder="Ví dụ: Sân VIP, sàn mới, gần quầy nước..." />
                                            </div>

                                            <div class="flex-between flex-wrap gap-3">
                                                <label style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--cb-text-secondary);">
                                                    <input type="hidden" name="IsActive" value="false" />
                                                    <input type="checkbox" name="IsActive" value="true" @(court.IsActive ? "checked" : null) />
                                                    <span>Bật trạng thái hoạt động</span>
                                                </label>
                                                <button type="submit" class="btn btn-outline btn-sm">Lưu sân con</button>
                                            </div>
                                        </form>
                                    }
                                }
                            </div>

                            <div style="height: 1px; background-color: var(--cb-border); margin: 1.5rem 0;"></div>

                            <form asp-controller="Admin" asp-action="CreateCourt" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="VenueId" value="@selectedVenue.Id" />
                                <input type="hidden" name="SelectedVenueId" value="@selectedVenue.Id" />

                                <div class="flex-between flex-wrap gap-3" style="margin-bottom: 1rem;">
                                    <div>
                                        <h4 style="margin: 0; font-size: 1rem;">Thêm sân con mới</h4>
                                        <p class="text-xs text-muted" style="margin-top: 0.25rem;">Sân mới được tạo ở trạng thái hoạt động và thuộc cụm sân đang chọn.</p>
                                    </div>
                                </div>

                                <div style="display: flex; flex-direction: column; gap: 1rem;">
                                    <div class="form-grid-2">
                                        <div class="form-group">
                                            <label class="form-label" for="new-court-name">Tên sân</label>
                                            <input id="new-court-name" name="Name" type="text" class="form-input" placeholder="Ví dụ: Sân số 5" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label" for="new-court-price">Giá thuê mỗi giờ</label>
                                            <input id="new-court-price" name="PricePerHour" type="number" class="form-input" min="50000" step="5000" value="100000" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="new-court-note">Ghi chú</label>
                                        <input id="new-court-note" name="Note" type="text" class="form-input" placeholder="Ví dụ: Sân VIP, sát quầy nước..." />
                                    </div>
                                </div>

                                <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
                                    <button type="submit" class="btn btn-primary">Thêm sân con</button>
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="card" style="padding: 1.5rem; border-style: dashed; border-color: var(--cb-border); background-color: white;">
                            <div class="font-semibold text-slate-900">Chưa có venue nào để chỉnh sửa</div>
                            <p class="text-sm text-secondary" style="margin-top: 0.375rem;">Hãy tạo một cụm sân mới bằng form bên dưới.</p>
                        </div>
                    }

                    <div class="card" id="new-venue-form" style="padding: 1.5rem; border-color: var(--cb-border); background-color: white;">
                        <div class="flex-between flex-wrap gap-3" style="margin-bottom: 1.25rem;">
                            <div>
                                <h3 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Tạo cụm sân mới</h3>
                                <p class="text-xs text-muted" style="margin-top: 0.25rem;">Cụm sân mới được tạo trực tiếp ở trạng thái công khai.</p>
                            </div>
                            <span class="badge badge-emerald">Công khai sau khi tạo</span>
                        </div>

                        <form asp-controller="Admin" asp-action="CreateVenue" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SelectedVenueId" value="@selectedVenue?.Id" />

                            <div style="display: flex; flex-direction: column; gap: 1rem;">
                                <div class="form-grid-2">
                                    <div class="form-group">
                                        <label class="form-label" for="new-venue-name">Tên cụm sân</label>
                                        <input id="new-venue-name" name="Name" type="text" class="form-input" placeholder="Ví dụ: Sân Cầu Lông An Phú" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="new-venue-district">Khu vực</label>
                                        <input id="new-venue-district" name="District" type="text" class="form-input" placeholder="Ví dụ: TP. Thủ Đức" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="new-venue-address">Địa chỉ</label>
                                    <input id="new-venue-address" name="Address" type="text" class="form-input" placeholder="Số nhà, đường, phường, quận..." />
                                </div>

                                <div class="form-grid-2">
                                    <div class="form-group">
                                        <label class="form-label" for="new-venue-contact-name">Người liên hệ</label>
                                        <input id="new-venue-contact-name" name="ContactName" type="text" class="form-input" value="@Model.AdminName" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="new-venue-contact-phone">Số điện thoại liên hệ</label>
                                        <input id="new-venue-contact-phone" name="ContactPhone" type="text" class="form-input" placeholder="Ví dụ: 0900000000" />
                                    </div>
                                </div>

                                <div class="form-grid-2">
                                    <div class="form-group">
                                        <label class="form-label" for="new-venue-open">Giờ mở cửa</label>
                                        <input id="new-venue-open" name="OpenTime" type="text" class="form-input" value="06:00" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="new-venue-close">Giờ đóng cửa</label>
                                        <input id="new-venue-close" name="CloseTime" type="text" class="form-input" value="22:00" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="new-venue-desc">Mô tả</label>
                                    <textarea id="new-venue-desc" name="Description" class="form-textarea" rows="4" placeholder="Giới thiệu cơ sở vật chất, vị trí địa lý, ưu điểm nổi bật..."></textarea>
                                </div>
                            </div>

                            <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
                                <button type="submit" class="btn btn-primary">Tạo cụm sân</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["ToastMessage"] != null)
            {
                <text>
                if (window.showToast) {
                    window.showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]", 4000);
                }
                </text>
            }
        });
    </script>
}
