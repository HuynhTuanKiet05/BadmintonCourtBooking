@model List<BadmintonCourtBooking.Models.Venue>
@{
    ViewData["Title"] = "Trang chủ - Đặt Sân Cầu Lông";
    var heroVenue = Model.FirstOrDefault();

    var displayDate = DateTime.Today;
    var dateLabel = "Hôm nay";
    if (DateTime.Now.Hour >= 20)
    {
        displayDate = DateTime.Today.AddDays(1);
        dateLabel = "Ngày mai";
    }

    // Get the slot matrix from ViewBag
    var slotMatrix = ViewBag.HeroSlotMatrix as Dictionary<string, Dictionary<string, BadmintonCourtBooking.Models.SlotStatus>>;
    
    // Determine the court to show
    var heroCourt = heroVenue?.Courts.FirstOrDefault();
    var courtName = heroCourt?.Name ?? "Sân 1";
    
    // Default mock slots
    var displaySlots = new List<string> { "17:00", "18:00", "19:00", "20:00" };
    
    // Resolve status for each slot
    var slotStatuses = new Dictionary<string, BadmintonCourtBooking.Models.SlotStatus>();
    foreach (var slot in displaySlots)
    {
        var status = BadmintonCourtBooking.Models.SlotStatus.Unavailable; // default if not found (or in past)
        
        if (slotMatrix != null && slotMatrix.ContainsKey(courtName) && slotMatrix[courtName].ContainsKey(slot))
        {
            status = slotMatrix[courtName][slot];
        }
        else
        {
            // Fallback / past time check
            var slotStart = displayDate.Date.Add(TimeSpan.Parse(slot));
            if (slotStart > DateTime.Now)
            {
                status = BadmintonCourtBooking.Models.SlotStatus.Available;
            }
        }
        
        slotStatuses[slot] = status;
    }

    // Find the first available slot to mark as selected by default
    var defaultSelectedSlot = displaySlots.FirstOrDefault(slot => slotStatuses[slot] == BadmintonCourtBooking.Models.SlotStatus.Available) 
        ?? "18:00"; // fallback if all booked
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-gradient"></div>
    <div class="absolute inset-0 pointer-events-none text-emerald-700/10">
        @await Html.PartialAsync("_CourtLines")
    </div>
    <div class="container hero-content">
        <div class="animate-fadeIn">
            <span class="badge badge-emerald mb-4">
                <i data-lucide="sparkles" style="width:14px;height:14px;margin-right:4px"></i> Nền tảng đặt sân cầu lông
            </span>
            <h1 class="hero-title">
                Đặt sân cầu lông dễ hơn,<br />chọn giờ chơi nhanh hơn.
            </h1>
            <p class="hero-desc">
                Đặt Sân Cầu Lông giúp người chơi tìm khung giờ trống, xem thông tin sân rõ ràng và đặt lịch trực tuyến chỉ trong vài chạm.
            </p>
            <div class="hero-cta">
                <a asp-controller="Venue" asp-action="Index" class="btn btn-primary btn-lg">
                    <i data-lucide="search" style="width:18px;height:18px"></i> Tìm sân ngay
                </a>
            </div>

        </div>

        <!-- Mock booking card -->
        <div class="relative animate-slideUp">
            <div class="absolute -top-6 -left-6 w-32 h-32 bg-amber-100 rounded-2xl rotate-6" style="z-index: 1;"></div>
            <div class="absolute -bottom-8 -right-4 w-28 h-28 bg-emerald-200/60 rounded-full" style="z-index: 1;"></div>
            <div class="card hero-card" style="z-index: 2;">
                <div class="flex-between">
                    <div>
                        <div class="font-semibold text-slate-900" style="font-size:1.125rem">@(heroVenue?.Name ?? "Sân Cầu Lông Phú Thọ")</div>
                        <div class="text-xs text-muted flex items-center gap-1 mt-1">
                            <i data-lucide="map-pin" style="width:12px;height:12px"></i> @(heroVenue is null ? "Quận 11, TP.HCM" : $"{heroVenue.District}, TP.HCM")
                        </div>
                    </div>
                    <span class="badge badge-emerald">@(heroVenue?.HasSlotsToday == true ? "Còn slot hôm nay" : "Nổi bật tuần này")</span>
                </div>
                <div class="text-xs text-muted" style="margin-top: 1rem;">@dateLabel · @BadmintonCourtBooking.Services.PresentationFormatter.FormatBookingDate(displayDate)</div>
                <div style="margin-top: 0.75rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem;">
                    @foreach (var slot in displaySlots)
                    {
                        var status = slotStatuses[slot];
                        var isSelected = slot == defaultSelectedSlot;
                        
                        if (status == BadmintonCourtBooking.Models.SlotStatus.Available)
                        {
                            var cls = isSelected ? "slot-pill slot-selected hero-slot-btn" : "slot-pill slot-available hero-slot-btn";
                            <button class="@cls" data-time="@slot">@slot</button>
                        }
                        else if (status == BadmintonCourtBooking.Models.SlotStatus.Pending)
                        {
                            <button class="slot-pill slot-booked hero-slot-btn" data-time="@slot" disabled title="Đang chờ duyệt">@slot</button>
                        }
                        else
                        {
                            <button class="slot-pill slot-booked hero-slot-btn" data-time="@slot" disabled>@slot</button>
                        }
                    }
                </div>
                <div class="flex-between" style="margin-top: 1.25rem; border-top: 1px dashed var(--cb-border); padding-top: 1rem;">
                    <div>
                        @{
                            var h = int.Parse(defaultSelectedSlot.Split(':')[0]);
                            var defaultEndSlot = $"{(h + 1):D2}:00";
                        }
                        <div class="text-xs text-muted" id="hero-selected-slot-info">@courtName · @defaultSelectedSlot – @defaultEndSlot</div>
                        <div class="font-bold" style="color:var(--cb-primary); font-size:1.125rem">@(heroCourt != null ? BadmintonCourtBooking.Models.MockData.FormatVND(heroCourt.PricePerHour) : (heroVenue is null ? "150.000₫" : BadmintonCourtBooking.Models.MockData.FormatVND(heroVenue.PriceFrom)))</div>
                    </div>
                    @if (heroVenue is null)
                    {
                        <a asp-controller="Venue" asp-action="Index" class="btn btn-primary" id="hero-booking-btn" data-date="@displayDate.ToString("yyyy-MM-dd")">Đặt sân</a>
                    }
                    else
                    {
                        <a asp-controller="Venue" asp-action="Detail" asp-route-id="@heroVenue.Id" class="btn btn-primary" id="hero-booking-btn" data-date="@displayDate.ToString("yyyy-MM-dd")">Đặt sân</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section style="background-color: white; padding: 4rem 0;">
    <div class="container">
        <div style="margin-bottom: 2.5rem;">
            <h2 class="text-center">Đặt sân chỉ với 3 bước</h2>
            <p class="text-secondary text-center" style="margin-top:0.25rem">Không gọi điện, không chờ tin nhắn phản hồi chậm trễ.</p>
        </div>
        <div class="grid-3 gap-6">
            <div class="card" style="padding: 1.5rem; text-align: center; border-color: var(--cb-border);">
                <div class="flex-center" style="width: 3rem; height: 3rem; border-radius: var(--cb-radius-lg); background-color: var(--cb-primary-light); color: var(--cb-primary); margin: 0 auto 1rem;">
                    <i data-lucide="search" style="width:24px;height:24px"></i>
                </div>
                <div class="text-xs text-muted" style="margin-bottom: 0.25rem;">Bước 1</div>
                <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Chọn sân gần bạn</h3>
                <p class="text-sm text-secondary">Lọc theo khu vực, mức giá, giờ hoạt động và trạng thái giờ trống thực tế.</p>
            </div>
            <div class="card" style="padding: 1.5rem; text-align: center; border-color: var(--cb-border);">
                <div class="flex-center" style="width: 3rem; height: 3rem; border-radius: var(--cb-radius-lg); background-color: var(--cb-primary-light); color: var(--cb-primary); margin: 0 auto 1rem;">
                    <i data-lucide="clock" style="width:24px;height:24px"></i>
                </div>
                <div class="text-xs text-muted" style="margin-bottom: 0.25rem;">Bước 2</div>
                <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Chọn khung giờ trống</h3>
                <p class="text-sm text-secondary">Xem bảng slot trực quan, biết ngay khung giờ nào còn trống để đặt trực tiếp.</p>
            </div>
            <div class="card" style="padding: 1.5rem; text-align: center; border-color: var(--cb-border);">
                <div class="flex-center" style="width: 3rem; height: 3rem; border-radius: var(--cb-radius-lg); background-color: var(--cb-primary-light); color: var(--cb-primary); margin: 0 auto 1rem;">
                    <i data-lucide="calendar-check" style="width:24px;height:24px"></i>
                </div>
                <div class="text-xs text-muted" style="margin-bottom: 0.25rem;">Bước 3</div>
                <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Xác nhận & Đến chơi</h3>
                <p class="text-sm text-secondary">Thanh toán giữ chỗ, nhận mã đặt sân tức thì và đến sân thi đấu đúng lịch hẹn.</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Venues Section -->
<section class="venues-section">
    <div class="container">
        <div class="flex-between" style="margin-bottom: 2rem;">
            <div>
                <h2>Sân nổi bật tuần này</h2>
                <p class="text-secondary text-sm" style="margin-top:0.25rem">Các cụm sân uy tín, chất lượng vượt trội được người chơi đánh giá cực cao.</p>
            </div>
            <a asp-controller="Venue" asp-action="Index" class="btn btn-ghost" style="color: var(--cb-primary); font-weight: 600;">
                Xem tất cả <i data-lucide="arrow-right" style="width:16px;height:16px;margin-left:4px"></i>
            </a>
        </div>
        
        <div class="grid-3 gap-6">
            @foreach (var venue in Model)
            {
                @await Html.PartialAsync("_VenueCard", venue)
            }
        </div>
    </div>
</section>

<!-- Footer -->
@await Html.PartialAsync("_Footer")

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const slots = document.querySelectorAll(".hero-slot-btn");
            const infoText = document.getElementById("hero-selected-slot-info");
            const bookingBtn = document.getElementById("hero-booking-btn");

            // Store original URL and set initial time & date parameter
            if (bookingBtn) {
                const originalUrl = bookingBtn.getAttribute("href");
                const dateVal = bookingBtn.getAttribute("data-date");
                const defaultTime = "@defaultSelectedSlot";
                bookingBtn.setAttribute("data-original-url", originalUrl);
                if (originalUrl) {
                    const separator = originalUrl.includes("?") ? "&" : "?";
                    bookingBtn.setAttribute("href", `${originalUrl}${separator}time=${defaultTime}&date=${dateVal}`);
                }
            }

            slots.forEach(slot => {
                slot.addEventListener("click", function () {
                    if (this.classList.contains("slot-booked")) return;

                    // Reset all slots to available class
                    slots.forEach(s => {
                        if (!s.classList.contains("slot-booked")) {
                            s.className = "slot-pill slot-available hero-slot-btn";
                        }
                    });

                    // Set current slot as selected
                    this.className = "slot-pill slot-selected hero-slot-btn";

                    // Update slot info description
                    const time = this.getAttribute("data-time");
                    const hour = parseInt(time.split(":")[0], 10);
                    const endTime = `${(hour + 1).toString().padStart(2, '0')}:00`;

                    infoText.textContent = `@Html.Raw(courtName) · ${time} – ${endTime}`;

                    // Update button link to pass the selected slot time and date
                    if (bookingBtn) {
                        const originalUrl = bookingBtn.getAttribute("data-original-url");
                        const dateVal = bookingBtn.getAttribute("data-date");
                        if (originalUrl) {
                            const separator = originalUrl.includes("?") ? "&" : "?";
                            bookingBtn.setAttribute("href", `${originalUrl}${separator}time=${time}&date=${dateVal}`);
                        }
                    }
                });
            });
        });
    </script>
}
