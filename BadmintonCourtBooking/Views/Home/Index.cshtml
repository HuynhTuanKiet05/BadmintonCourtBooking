@model List<BadmintonCourtBooking.Models.Venue>
@{
    ViewData["Title"] = "Trang chủ - CourtBook";
    var heroVenue = Model.FirstOrDefault();
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-gradient"></div>
    <div class="absolute inset-0 pointer-events-none text-emerald-700/10">
        @await Html.PartialAsync("_CourtLines")
    </div>
    <div class="container hero-content">
        <div class="animate-fadeIn">
            <span class="badge badge-emerald mb-4">
                <i data-lucide="sparkles" style="width:14px;height:14px;margin-right:4px"></i> Nền tảng đặt sân cầu lông
            </span>
            <h1 class="hero-title">
                Đặt sân cầu lông dễ hơn,<br />chọn giờ chơi nhanh hơn.
            </h1>
            <p class="hero-desc">
                CourtBook giúp người chơi tìm khung giờ trống, xem thông tin sân rõ ràng và đặt lịch trực tuyến chỉ trong vài chạm.
            </p>
            <div class="hero-cta">
                <a asp-controller="Venue" asp-action="Index" class="btn btn-primary btn-lg">
                    <i data-lucide="search" style="width:18px;height:18px"></i> Tìm sân ngay
                </a>
            </div>
            <div class="hero-stats">
                <div class="flex items-center gap-2"><i data-lucide="users" style="width:16px;height:16px;color:var(--cb-primary)"></i> 12.000+ người chơi</div>
                <div class="flex items-center gap-2"><i data-lucide="shield-check" style="width:16px;height:16px;color:var(--cb-primary)"></i> 180+ cụm sân đã duyệt</div>
            </div>
        </div>

        <!-- Mock booking card -->
        <div class="relative animate-slideUp">
            <div class="absolute -top-6 -left-6 w-32 h-32 bg-amber-100 rounded-2xl rotate-6" style="z-index: 1;"></div>
            <div class="absolute -bottom-8 -right-4 w-28 h-28 bg-emerald-200/60 rounded-full" style="z-index: 1;"></div>
            <div class="card hero-card" style="z-index: 2;">
                <div class="flex-between">
                    <div>
                        <div class="font-semibold text-slate-900" style="font-size:1.125rem">@(heroVenue?.Name ?? "Sân Cầu Lông Phú Thọ")</div>
                        <div class="text-xs text-muted flex items-center gap-1 mt-1">
                            <i data-lucide="map-pin" style="width:12px;height:12px"></i> @(heroVenue is null ? "Quận 11, TP.HCM" : $"{heroVenue.District}, TP.HCM")
                        </div>
                    </div>
                    <span class="badge badge-emerald">@(heroVenue?.HasSlotsToday == true ? "Còn slot hôm nay" : "Nổi bật tuần này")</span>
                </div>
                <div class="text-xs text-muted" style="margin-top: 1rem;">Hôm nay · Thứ 4, 20/05/2026</div>
                <div style="margin-top: 0.75rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem;">
                    <button class="slot-pill slot-available">17:00</button>
                    <button class="slot-pill slot-selected">18:00</button>
                    <button class="slot-pill slot-booked" disabled>19:00</button>
                    <button class="slot-pill slot-available">20:00</button>
                </div>
                <div class="flex-between" style="margin-top: 1.25rem; border-top: 1px dashed var(--cb-border); padding-top: 1rem;">
                    <div>
                        <div class="text-xs text-muted">Sân VIP · 18:00 – 19:00</div>
                        <div class="font-bold" style="color:var(--cb-primary); font-size:1.125rem">@(heroVenue is null ? "150.000₫" : BadmintonCourtBooking.Models.MockData.FormatVND(heroVenue.PriceFrom))</div>
                    </div>
                    @if (heroVenue is null)
                    {
                        <a asp-controller="Venue" asp-action="Index" class="btn btn-primary">Đặt sân</a>
                    }
                    else
                    {
                        <a asp-controller="Venue" asp-action="Detail" asp-route-id="@heroVenue.Id" class="btn btn-primary">Đặt sân</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section style="background-color: white; padding: 4rem 0;">
    <div class="container">
        <div style="margin-bottom: 2.5rem;">
            <h2 class="text-center">Đặt sân chỉ với 3 bước</h2>
            <p class="text-secondary text-center" style="margin-top:0.25rem">Không gọi điện, không chờ tin nhắn phản hồi chậm trễ.</p>
        </div>
        <div class="grid-3 gap-6">
            <div class="card" style="padding: 1.5rem; text-align: center; border-color: var(--cb-border);">
                <div class="flex-center" style="width: 3rem; height: 3rem; border-radius: var(--cb-radius-lg); background-color: var(--cb-primary-light); color: var(--cb-primary); margin: 0 auto 1rem;">
                    <i data-lucide="search" style="width:24px;height:24px"></i>
                </div>
                <div class="text-xs text-muted" style="margin-bottom: 0.25rem;">Bước 1</div>
                <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Chọn sân gần bạn</h3>
                <p class="text-sm text-secondary">Lọc theo khu vực, mức giá, giờ hoạt động và trạng thái giờ trống thực tế.</p>
            </div>
            <div class="card" style="padding: 1.5rem; text-align: center; border-color: var(--cb-border);">
                <div class="flex-center" style="width: 3rem; height: 3rem; border-radius: var(--cb-radius-lg); background-color: var(--cb-primary-light); color: var(--cb-primary); margin: 0 auto 1rem;">
                    <i data-lucide="clock" style="width:24px;height:24px"></i>
                </div>
                <div class="text-xs text-muted" style="margin-bottom: 0.25rem;">Bước 2</div>
                <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Chọn khung giờ trống</h3>
                <p class="text-sm text-secondary">Xem bảng slot trực quan, biết ngay khung giờ nào còn trống để đặt trực tiếp.</p>
            </div>
            <div class="card" style="padding: 1.5rem; text-align: center; border-color: var(--cb-border);">
                <div class="flex-center" style="width: 3rem; height: 3rem; border-radius: var(--cb-radius-lg); background-color: var(--cb-primary-light); color: var(--cb-primary); margin: 0 auto 1rem;">
                    <i data-lucide="calendar-check" style="width:24px;height:24px"></i>
                </div>
                <div class="text-xs text-muted" style="margin-bottom: 0.25rem;">Bước 3</div>
                <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Xác nhận & Đến chơi</h3>
                <p class="text-sm text-secondary">Thanh toán giữ chỗ, nhận mã đặt sân tức thì và đến sân thi đấu đúng lịch hẹn.</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Venues Section -->
<section class="venues-section">
    <div class="container">
        <div class="flex-between" style="margin-bottom: 2rem;">
            <div>
                <h2>Sân nổi bật tuần này</h2>
                <p class="text-secondary text-sm" style="margin-top:0.25rem">Các cụm sân uy tín, chất lượng vượt trội được người chơi đánh giá cực cao.</p>
            </div>
            <a asp-controller="Venue" asp-action="Index" class="btn btn-ghost" style="color: var(--cb-primary); font-weight: 600;">
                Xem tất cả <i data-lucide="arrow-right" style="width:16px;height:16px;margin-left:4px"></i>
            </a>
        </div>
        
        <div class="grid-3 gap-6">
            @foreach (var venue in Model)
            {
                @await Html.PartialAsync("_VenueCard", venue)
            }
        </div>
    </div>
</section>

<!-- Footer -->
@await Html.PartialAsync("_Footer")
