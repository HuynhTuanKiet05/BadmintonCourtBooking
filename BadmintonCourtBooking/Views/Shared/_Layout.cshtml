@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Đặt Sân Cầu Lông</title>
    <meta name="description" content="Đặt Sân Cầu Lông - Nền tảng đặt sân trực tuyến hàng đầu tại TP.HCM" />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/courtbook.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header class="header" id="main-header">
        <div class="header-inner">
            <div class="header-left">
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="logo">
                    <div class="logo-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <!-- Racket Head -->
                            <ellipse cx="15.5" cy="8.5" rx="4.2" ry="5.2" transform="rotate(45 15.5 8.5)" stroke="currentColor" stroke-width="1.8" />
                            
                            <!-- String Grid -->
                            <g transform="rotate(45 15.5 8.5)" opacity="0.8">
                                <path d="M15.5 3.3 V13.7 M13.7 3.9 V13.1 M17.3 3.9 V13.1 M11.3 8.5 H19.7 M12.0 6.3 H19.0 M12.0 10.7 H19.0" stroke="currentColor" stroke-width="0.8" />
                            </g>
                            
                            <!-- Shaft -->
                            <line x1="12.0" y1="12.0" x2="5.5" y2="18.5" stroke="currentColor" stroke-width="1.8" />
                            <!-- Grip -->
                            <line x1="5.5" y1="18.5" x2="2.5" y2="21.5" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
                            
                            <!-- Shuttlecock -->
                            <!-- Cork Base -->
                            <circle cx="8.2" cy="8.2" r="1.6" fill="currentColor" stroke="none" />
                            <!-- Feather Skirt -->
                            <path d="M7.0 7.0 L3.0 3.0 M7.2 8.2 L3.2 5.0 M8.2 7.2 L5.0 3.2 M6.8 8.0 L3.0 6.0 M8.0 6.8 L6.0 3.0" stroke="currentColor" stroke-width="1.2" />
                            <!-- Connecting threads -->
                            <path d="M4.2 4.2 C 4.8 3.8, 5.2 4.2, 5.8 4.2 M 4.8 5.2 C 5.2 4.8, 5.2 5.2, 5.8 4.8" stroke="currentColor" stroke-width="0.8" fill="none" />
                        </svg>
                    </div>
                    <div class="logo-text">
                        <div class="logo-name">Đặt Sân Cầu Lông</div>
                        <div class="logo-sub">Hệ thống trực tuyến</div>
                    </div>
                </a>

                <!-- Desktop Navigation -->
                <nav class="nav-links md-flex" id="desktop-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Trang chủ</a>
                    <a asp-controller="Venue" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Venue" ? "active" : "")">Tìm sân</a>
                    @if (User.IsInRole("Player"))
                    {
                        <a asp-controller="Booking" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")">Lịch của tôi</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                            <i data-lucide="shield" style="width:14px;height:14px"></i> Quản trị
                        </a>
                    }
                </nav>
            </div>

            <!-- Auth Buttons (desktop) -->
            <div class="auth-buttons md-show">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var name = User.Identity?.Name ?? "Tài khoản Đặt Sân Cầu Lông";
                    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Player";
                    var roleLabel = role switch
                    {
                        "Admin" => "Quản trị viên",
                        _ => "Người chơi"
                    };
                    var initials = "";
                    try
                    {
                        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        if (parts.Length > 1) {
                            initials = (parts[parts.Length - 2][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
                        } else if (parts.Length == 1) {
                            initials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                        } else {
                            initials = "MK";
                        }
                    }
                    catch {
                        initials = "MK";
                    }
                    var avatarPath = User.FindFirstValue("AvatarPath");
                    <div style="display:flex; align-items:center; gap:0.75rem;">
                        <!-- Notification Dropdown -->
                        <div class="dropdown" style="position: relative; margin-right: 0.25rem;">
                            <button class="btn btn-icon btn-ghost" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 4px; display: flex; align-items: center; justify-content: center; position: relative; border: none; background: none;">
                                <i data-lucide="bell" style="width:18px;height:18px;color:#475569"></i>
                                <span id="notification-badge" style="position: absolute; top: 2px; right: 2px; width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; border: 1px solid #ffffff; display: none;"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationDropdown" style="width: 320px; padding: 0.5rem 0; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); border-color: #e2e8f0; border-radius: 0.5rem; font-size: 0.8125rem; max-height: 380px; overflow-y: auto;">
                                <li style="padding: 0.5rem 1rem; border-bottom: 1px solid #f1f5f9; font-weight: 600; color: #1e293b; display: flex; justify-content: space-between; align-items: center;">
                                    <span>Thông báo</span>
                                    <span id="notification-count" class="badge bg-emerald-500" style="font-size: 0.6875rem; display: none;">0</span>
                                </li>
                                <div id="notification-list" style="padding: 0;">
                                    <li id="notification-loading" style="padding: 1.5rem 1rem; text-align: center; color: #64748b;">
                                        Đang tải thông báo...
                                    </li>
                                </div>
                            </ul>
                        </div>

                        <a asp-controller="Account" asp-action="Profile" class="flex-align gap-2 hover-opacity-80" style="text-decoration:none; display: flex; align-items: center;">
                            @if (!string.IsNullOrWhiteSpace(avatarPath))
                            {
                                <img src="@avatarPath" alt="Avatar" style="width:36px; height:36px; border-radius:50%; object-fit:cover; border: 2px solid #a7f3d0;" />
                            }
                            else
                            {
                                <div class="avatar" style="width:36px; height:36px; border-radius:50%; background-color:#d1fae5; color:#065f46; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:14px; border: 1px solid #a7f3d0;">
                                    @initials
                                </div>
                            }
                            <div class="text-xs" style="text-align:left; line-height:1.2; margin-left: 8px;">
                                <div class="font-medium text-slate-900" style="color:#0f172a; font-weight: 500;">@name</div>
                                <div class="text-slate-500" style="font-size:10px; color:#64748b">@roleLabel</div>
                            </div>
                        </a>
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-icon btn-ghost" title="Đăng xuất" style="padding:4px; margin-left:8px; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                                <i data-lucide="log-out" style="width:16px;height:16px;color:#e11d48"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-ghost" style="text-decoration: none;">Đăng nhập</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary" style="text-decoration: none;">Đăng ký</a>
                }
            </div>

            <!-- Hamburger (mobile) -->
            <button class="btn btn-icon btn-ghost mobile-only" id="hamburger-btn" aria-label="Menu">
                <i data-lucide="menu" style="width:20px;height:20px"></i>
            </button>
        </div>
    </header>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-overlay" id="mobile-overlay"></div>
    <div class="mobile-menu" id="mobile-menu">
        <div class="flex-between" style="margin-bottom:1.5rem">
            <span class="font-semibold">Menu</span>
            <button class="btn btn-icon btn-ghost" id="close-menu-btn">
                <i data-lucide="x" style="width:20px;height:20px"></i>
            </button>
        </div>
        <a asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a>
        <a asp-controller="Venue" asp-action="Index" class="nav-link">Tìm sân</a>
        @if (User.IsInRole("Player"))
        {
            <a asp-controller="Booking" asp-action="Index" class="nav-link">Lịch của tôi</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="nav-link">Quản trị</a>
        }
        <div style="border-top:1px solid var(--cb-border);margin:1rem 0"></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="nav-link" style="padding: 0.5rem 0.75rem; border-radius: 0.375rem; text-decoration: none; display: block;">Hồ sơ cá nhân</a>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="margin-top: 0.25rem;">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link text-danger" style="padding: 0.5rem 0.75rem; border-radius: 0.375rem; color:#e11d48; text-decoration: none; display: block; margin-top: 0.25rem; background:none; border:none; width:100%; text-align:left;">Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline w-full" style="text-decoration:none; text-align:center; display:block;">Đăng nhập</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary w-full" style="margin-top:0.5rem; text-decoration:none; text-align:center; display:block;">Đăng ký</a>
        }
    </div>

    <!-- Toast Container -->
    @await Html.PartialAsync("_Toast")

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    <script>lucide.createIcons();</script>
</body>
</html>
