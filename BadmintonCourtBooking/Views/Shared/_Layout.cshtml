@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtBook</title>
    <meta name="description" content="CourtBook - Nền tảng đặt sân cầu lông trực tuyến hàng đầu tại TP.HCM" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    <!-- Chart.js (for owner dashboard) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/courtbook.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header class="header" id="main-header">
        <div class="header-inner">
            <div class="header-left">
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="logo">
                    <div class="logo-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 19l9-9" /><circle cx="16" cy="7" r="3" /><path d="M3 21l4-1 1-3" />
                        </svg>
                    </div>
                    <div class="logo-text">
                        <div class="logo-name">CourtBook</div>
                        <div class="logo-sub">Đặt sân cầu lông</div>
                    </div>
                </a>

                <!-- Desktop Navigation -->
                <nav class="nav-links md-flex" id="desktop-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Trang chủ</a>
                    <a asp-controller="Venue" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Venue" ? "active" : "")">Tìm sân</a>
                    @if (User.IsInRole("Player"))
                    {
                        <a asp-controller="Booking" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")">Lịch của tôi</a>
                    }
                    @if (User.IsInRole("Owner"))
                    {
                        <a asp-controller="Owner" asp-action="Dashboard" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Owner" ? "active" : "")">Dành cho chủ sân</a>
                    }
                    else if (!(User.Identity?.IsAuthenticated ?? false))
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-role="owner" class="nav-link">Dành cho chủ sân</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                            <i data-lucide="shield" style="width:14px;height:14px"></i> Admin
                        </a>
                    }
                </nav>
            </div>

            <!-- Auth Buttons (desktop) -->
            <div class="auth-buttons md-show">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var name = User.Identity?.Name ?? "Tài khoản CourtBook";
                    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Player";
                    var roleLabel = role switch
                    {
                        "Owner" => "Chủ cụm sân",
                        "Admin" => "Quản trị viên",
                        _ => "Người chơi"
                    };
                    var initials = "";
                    try
                    {
                        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        if (parts.Length > 1) {
                            initials = (parts[parts.Length - 2][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
                        } else if (parts.Length == 1) {
                            initials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                        } else {
                            initials = "MK";
                        }
                    }
                    catch {
                        initials = "MK";
                    }
                    <div style="display:flex; align-items:center; gap:0.75rem;">
                        <a asp-controller="Account" asp-action="Profile" class="flex-align gap-2 hover-opacity-80" style="text-decoration:none; display: flex; align-items: center;">
                            <div class="avatar" style="width:36px; height:36px; border-radius:50%; background-color:#d1fae5; color:#065f46; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:14px; border: 1px solid #a7f3d0;">
                                @initials
                            </div>
                            <div class="text-xs" style="text-align:left; line-height:1.2; margin-left: 8px;">
                                <div class="font-medium text-slate-900" style="color:#0f172a; font-weight: 500;">@name</div>
                                <div class="text-slate-500" style="font-size:10px; color:#64748b">@roleLabel</div>
                            </div>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-icon btn-ghost" title="Đăng xuất" style="padding:4px; margin-left:8px; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                                <i data-lucide="log-out" style="width:16px;height:16px;color:#e11d48"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-ghost" style="text-decoration: none;">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary" style="text-decoration: none;">Đăng ký</a>
                }
            </div>

            <!-- Hamburger (mobile) -->
            <button class="btn btn-icon btn-ghost mobile-only" id="hamburger-btn" aria-label="Menu">
                <i data-lucide="menu" style="width:20px;height:20px"></i>
            </button>
        </div>
    </header>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-overlay" id="mobile-overlay"></div>
    <div class="mobile-menu" id="mobile-menu">
        <div class="flex-between" style="margin-bottom:1.5rem">
            <span class="font-semibold">Menu</span>
            <button class="btn btn-icon btn-ghost" id="close-menu-btn">
                <i data-lucide="x" style="width:20px;height:20px"></i>
            </button>
        </div>
        <a asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a>
        <a asp-controller="Venue" asp-action="Index" class="nav-link">Tìm sân</a>
        @if (User.IsInRole("Player"))
        {
            <a asp-controller="Booking" asp-action="Index" class="nav-link">Lịch của tôi</a>
        }
        @if (User.IsInRole("Owner"))
        {
            <a asp-controller="Owner" asp-action="Dashboard" class="nav-link">Dành cho chủ sân</a>
        }
        else if (!(User.Identity?.IsAuthenticated ?? false))
        {
            <a asp-controller="Account" asp-action="Login" asp-route-role="owner" class="nav-link">Dành cho chủ sân</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="nav-link">Admin</a>
        }
        <div style="border-top:1px solid var(--cb-border);margin:1rem 0"></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Account" asp-action="Profile" class="nav-link" style="padding: 0.5rem 0.75rem; border-radius: 0.375rem; text-decoration: none; display: block;">Hồ sơ cá nhân</a>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top: 0.25rem;">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link text-danger" style="padding: 0.5rem 0.75rem; border-radius: 0.375rem; color:#e11d48; text-decoration: none; display: block; margin-top: 0.25rem; background:none; border:none; width:100%; text-align:left;">Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline w-full" style="text-decoration:none; text-align:center; display:block;">Đăng nhập</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary w-full" style="margin-top:0.5rem; text-decoration:none; text-align:center; display:block;">Đăng ký</a>
        }
    </div>

    <!-- Toast Container -->
    @await Html.PartialAsync("_Toast")

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>lucide.createIcons();</script>
</body>
</html>
