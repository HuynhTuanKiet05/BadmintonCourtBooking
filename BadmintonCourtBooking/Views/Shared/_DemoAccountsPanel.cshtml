@using BadmintonCourtBooking.Data

<div style="border:1px solid #d1fae5; background:#f0fdf4; border-radius:0.75rem; padding:0.875rem; margin-bottom:1rem;">
    <div style="display:flex; justify-content:space-between; gap:0.75rem; align-items:flex-start; flex-wrap:wrap;">
        <div>
            <div style="font-size:0.875rem; font-weight:600; color:#14532d;">Đăng nhập nhanh tài khoản demo</div>
            <div style="font-size:0.75rem; color:#166534; margin-top:0.15rem;">
                Dùng để chạy demo player, owner và admin mà không cần gõ lại thủ công.
            </div>
        </div>
        <span style="font-size:0.72rem; color:#166534; background:#dcfce7; border:1px solid #86efac; border-radius:999px; padding:0.2rem 0.55rem;">
            Seed tự động khi app khởi động
        </span>
    </div>

    <div style="display:grid; gap:0.5rem; margin-top:0.75rem;">
        <button type="button"
                class="demo-account-btn"
                data-demo-email="@DemoDataConstants.DemoPlayerEmail"
                data-demo-password="@DemoDataConstants.DemoPlayerPassword"
                data-demo-role="player"
                style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem; width:100%; border:1px solid #bbf7d0; background:#ffffff; border-radius:0.65rem; padding:0.7rem 0.85rem;">
            <span style="text-align:left;">
                <strong style="display:block; font-size:0.85rem; color:#14532d;">Người chơi demo</strong>
                <span style="font-size:0.73rem; color:#166534;">@DemoDataConstants.DemoPlayerEmail · @DemoDataConstants.DemoPlayerPassword</span>
            </span>
            <span style="font-size:0.72rem; color:#15803d;">Điền nhanh</span>
        </button>

        <button type="button"
                class="demo-account-btn"
                data-demo-email="@DemoDataConstants.DemoOwnerEmail"
                data-demo-password="@DemoDataConstants.DemoOwnerPassword"
                data-demo-role="owner"
                style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem; width:100%; border:1px solid #bbf7d0; background:#ffffff; border-radius:0.65rem; padding:0.7rem 0.85rem;">
            <span style="text-align:left;">
                <strong style="display:block; font-size:0.85rem; color:#14532d;">Chủ sân demo</strong>
                <span style="font-size:0.73rem; color:#166534;">@DemoDataConstants.DemoOwnerEmail · @DemoDataConstants.DemoOwnerPassword</span>
            </span>
            <span style="font-size:0.72rem; color:#15803d;">Điền nhanh</span>
        </button>

        <button type="button"
                class="demo-account-btn"
                data-demo-email="@DemoDataConstants.DemoAdminEmail"
                data-demo-password="@DemoDataConstants.DemoAdminPassword"
                style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem; width:100%; border:1px solid #bbf7d0; background:#ffffff; border-radius:0.65rem; padding:0.7rem 0.85rem;">
            <span style="text-align:left;">
                <strong style="display:block; font-size:0.85rem; color:#14532d;">Quản trị viên demo</strong>
                <span style="font-size:0.73rem; color:#166534;">@DemoDataConstants.DemoAdminEmail · @DemoDataConstants.DemoAdminPassword</span>
            </span>
            <span style="font-size:0.72rem; color:#15803d;">Điền nhanh</span>
        </button>
    </div>
</div>
