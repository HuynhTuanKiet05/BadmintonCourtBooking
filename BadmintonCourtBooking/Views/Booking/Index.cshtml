@model List<BadmintonCourtBooking.Models.Booking>
@{
    ViewData["Title"] = "Lịch của tôi - CourtBook";
    
    var upcoming = Model.Where(b => b.When == "upcoming").ToList();
    var completed = Model.Where(b => b.When == "completed").ToList();
    var cancelled = Model.Where(b => b.When == "cancelled").ToList();
}

<main class="bookings-page animate-fadeIn">
    <!-- Header Title -->
    <div style="margin-bottom: 2rem;">
        <h1>Lịch đặt sân của tôi</h1>
        <p class="text-secondary text-sm" style="margin-top: 0.25rem;">Quản lý các lịch đặt sắp tới và lịch sử đã thi đấu.</p>
    </div>

    <!-- Tabs Container -->
    <div id="bookings-tabs-container">
        <div class="tabs">
            <button class="tab-btn active" data-tab="tab-upcoming">
                Sắp tới <span class="tab-count">@upcoming.Count</span>
            </button>
            <button class="tab-btn" data-tab="tab-completed">
                Đã hoàn thành <span class="tab-count">@completed.Count</span>
            </button>
            <button class="tab-btn" data-tab="tab-cancelled">
                Đã hủy <span class="tab-count">@cancelled.Count</span>
            </button>
        </div>

        <!-- ── TAB: UPCOMING ── -->
        <div class="tab-panel active" id="tab-upcoming">
            @if (upcoming.Count == 0)
            {
                @await Html.PartialAsync("_EmptyBookingsState")
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var b in upcoming)
                    {
                        <div class="card booking-card" style="border-color: var(--cb-border); background-color: white;">
                            <div class="flex-between flex-wrap gap-3">
                                <div class="flex-1" style="min-width: 250px;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                        <h3 style="font-size: 1.125rem; margin: 0; font-weight: 600;">@b.Venue</h3>
                                        @await Html.PartialAsync("_StatusBadge", b.Status)
                                    </div>
                                    <div class="text-sm font-medium" style="color: var(--cb-primary); margin-top: 0.25rem;">
                                        @b.Court
                                    </div>
                                    <div class="flex-wrap gap-x-4 gap-y-1 text-xs text-muted" style="display: flex; margin-top: 0.75rem;">
                                        <span class="flex items-center gap-1"><i data-lucide="calendar" style="width:13px;height:13px"></i> @b.Date</span>
                                        <span class="flex items-center gap-1"><i data-lucide="clock" style="width:13px;height:13px"></i> @b.Time</span>
                                        <span class="flex items-center gap-1"><i data-lucide="map-pin" style="width:13px;height:13px"></i> TP. Hồ Chí Minh</span>
                                    </div>
                                </div>

                                <div style="display: flex; flex-direction: column; align-items: flex-end; justify-between: space-between; text-align: right; gap: 0.75rem;">
                                    <div>
                                        <div class="text-xs text-muted">Tổng cộng</div>
                                        <div class="font-bold" style="color: var(--cb-primary); font-size: 1.125rem;">@BadmintonCourtBooking.Models.MockData.FormatVND(b.Total)</div>
                                    </div>
                                    <div style="display: flex; gap: 0.5rem;">
                                        @if (b.Status != BadmintonCourtBooking.Models.BookingStatus.Cancelled)
                                        {
                                            <form asp-controller="Booking" asp-action="Cancel" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch đặt sân này?');">
                                                <button type="submit" class="btn btn-destructive btn-sm">Hủy lịch</button>
                                            </form>
                                        }
                                        <button class="btn btn-outline btn-sm" onclick="showToast('Xem chi tiết đặt lịch ID: @b.Id', 'success')">Chi tiết</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ── TAB: COMPLETED ── -->
        <div class="tab-panel" id="tab-completed">
            @if (completed.Count == 0)
            {
                @await Html.PartialAsync("_EmptyBookingsState")
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var b in completed)
                    {
                        <div class="card booking-card" style="border-color: var(--cb-border); background-color: white;">
                            <div class="flex-between flex-wrap gap-3">
                                <div class="flex-1" style="min-width: 250px;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                        <h3 style="font-size: 1.125rem; margin: 0; font-weight: 600;">@b.Venue</h3>
                                        @await Html.PartialAsync("_StatusBadge", b.Status)
                                    </div>
                                    <div class="text-sm font-medium" style="color: var(--cb-primary); margin-top: 0.25rem;">
                                        @b.Court
                                    </div>
                                    <div class="flex-wrap gap-x-4 gap-y-1 text-xs text-muted" style="display: flex; margin-top: 0.75rem;">
                                        <span class="flex items-center gap-1"><i data-lucide="calendar" style="width:13px;height:13px"></i> @b.Date</span>
                                        <span class="flex items-center gap-1"><i data-lucide="clock" style="width:13px;height:13px"></i> @b.Time</span>
                                        <span class="flex items-center gap-1"><i data-lucide="map-pin" style="width:13px;height:13px"></i> TP. Hồ Chí Minh</span>
                                    </div>
                                </div>

                                <div style="display: flex; flex-direction: column; align-items: flex-end; justify-between: space-between; text-align: right; gap: 0.75rem;">
                                    <div>
                                        <div class="text-xs text-muted">Tổng cộng</div>
                                        <div class="font-bold text-slate-900" style="font-size: 1.125rem;">@BadmintonCourtBooking.Models.MockData.FormatVND(b.Total)</div>
                                    </div>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <button class="btn btn-outline btn-sm" onclick="showToast('Phản hồi đánh giá sân ID: @b.Id', 'success')">Đánh giá</button>
                                        <button class="btn btn-outline btn-sm" onclick="showToast('Xem chi tiết lịch đặt ID: @b.Id', 'success')">Chi tiết</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ── TAB: CANCELLED ── -->
        <div class="tab-panel" id="tab-cancelled">
            @if (cancelled.Count == 0)
            {
                @await Html.PartialAsync("_EmptyBookingsState")
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var b in cancelled)
                    {
                        <div class="card booking-card" style="border-color: var(--cb-border); background-color: white; opacity: 0.8;">
                            <div class="flex-between flex-wrap gap-3">
                                <div class="flex-1" style="min-width: 250px;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                        <h3 style="font-size: 1.125rem; margin: 0; font-weight: 600; color: var(--cb-text-secondary);">@b.Venue</h3>
                                        @await Html.PartialAsync("_StatusBadge", b.Status)
                                    </div>
                                    <div class="text-sm font-medium text-secondary" style="margin-top: 0.25rem;">
                                        @b.Court
                                    </div>
                                    <div class="flex-wrap gap-x-4 gap-y-1 text-xs text-muted" style="display: flex; margin-top: 0.75rem;">
                                        <span class="flex items-center gap-1"><i data-lucide="calendar" style="width:13px;height:13px"></i> @b.Date</span>
                                        <span class="flex items-center gap-1"><i data-lucide="clock" style="width:13px;height:13px"></i> @b.Time</span>
                                        <span class="flex items-center gap-1"><i data-lucide="map-pin" style="width:13px;height:13px"></i> TP. Hồ Chí Minh</span>
                                    </div>
                                </div>

                                <div style="display: flex; flex-direction: column; align-items: flex-end; justify-between: space-between; text-align: right; gap: 0.75rem;">
                                    <div>
                                        <div class="text-xs text-muted">Tổng cộng</div>
                                        <div class="font-semibold text-secondary" style="font-size: 1.125rem; text-decoration: line-through;">@BadmintonCourtBooking.Models.MockData.FormatVND(b.Total)</div>
                                    </div>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <a asp-controller="Venue" asp-action="Detail" asp-route-id="v1" class="btn btn-primary btn-sm">Đặt lại</a>
                                        <button class="btn btn-outline btn-sm" onclick="showToast('Xem chi tiết lịch đặt ID: @b.Id', 'success')">Chi tiết</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize tab switching
            if (window.initTabs) {
                window.initTabs('#bookings-tabs-container');
            }
            
            // Check for TempData toast alerts
            @if (TempData["ToastMessage"] != null)
            {
                <text>
                if (window.showToast) {
                    window.showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]", 4000);
                }
                </text>
            }
        });
    </script>
}
